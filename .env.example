# Base de datos local (SQLite). En producción usar Turso/libSQL.
DATABASE_URL=file:./local.db
# Para Turso en producción:
# DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=

# Secreto para firmar la sesión. Cambiar por un valor largo y aleatorio.
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Punto de venta usado en numeración de facturas/recibos.
PUNTO_VENTA=0001
